# ==========================================
# 환경 변수 예시 파일
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
#   cp .env.example .env
# .env 는 절대 저장소에 커밋하지 않습니다.
# ==========================================

# ----- 애플리케이션 -----
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ----- 인증 / 세션 -----
# 세션·JWT 서명용 랜덤 문자열 (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- AI API -----
# AI 제공사에서 발급받은 키
AI_API_KEY=
# 사용할 모델 이름 (비워두면 코드 기본값 사용)
AI_MODEL=
AI_TIMEOUT_SECONDS=10        # AI 호출 1회 타임아웃 (초). 제공사 하한이 10초라 더 낮추면 400으로 거부된다
AI_TOTAL_TIMEOUT_SECONDS=26  # 재시도·폴백을 모두 합친 상한 (초)
AI_MAX_RETRIES=1             # 같은 모델로 재시도할 횟수
AI_CONTEXT_TURNS=5           # 문맥 유지에 사용할 직전 대화 수 (0이면 문맥 미사용)
AI_MAX_TOKENS=800            # 답변 최대 출력 토큰. 800은 한국어 기준 대략 400~600자다

# ----- 입력 검증 -----
MAX_QUESTION_LENGTH=5000     # 질문 최대 글자 수

# ----- DB -----
MYSQL_DATABASE=chatbot_db
MYSQL_USER=chatbot_user
MYSQL_PASSWORD=chatbot_password
MYSQL_ROOT_PASSWORD=root_password
